# Event Team Builder - environment configuration
# Copy to .env and fill in. Never commit real credentials.

# Port for the Express API server
PORT=5000

# Set to "production" to have Express serve the built client from client/dist
NODE_ENV=development

# MongoDB
# Leave blank to run in resilient local fallback mode (in-memory seed data).
#
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/event-team-builder
#
# MongoDB Atlas (replace user/password/cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/event-team-builder?retryWrites=true&w=majority
#
# You can also paste a URI at runtime from the app Settings page
# or the "MongoDB Connected" pill in the navbar.
# Auth
# Secret used to sign session JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be set in production - the server refuses to sign tokens without it.
JWT_SECRET=
# How long a signed-in session stays valid
JWT_EXPIRES_IN=7d

# Coordinator self-registration
# Required by the "Register as Coordinator" option in the web UI.
# Leave blank to disable coordinator signup entirely. Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
COORDINATOR_INVITE_CODE=